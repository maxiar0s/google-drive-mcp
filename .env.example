MCP_ACCESS_TOKEN=replace-with-a-random-token-at-least-32-characters-long
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
OAUTH_ISSUER=workers_url
# This environmente variable must be set on build time variables, not runtime.
OAUTH_KV_ID = KV_ID  
# Optional: comma-separated folder IDs; denied folders include descendants.
# GOOGLE_DRIVE_MCP_BLOCKED_FOLDER_IDS=folder-id-1,folder-id-2